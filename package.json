{
  "name": "kfm-mdcompletions",
  "author": {
    "name": "Technical Writers",
    "email": "dontbotherme@bumbaclot.com"
  },
  "displayName": "Kfm-MdCompletions",
  "description": "Provides completions for Kentico-flavored markdown syntax.",
  "repository": {
    "url": "https://KenticoCustomerSuccess@dev.azure.com/KenticoCustomerSuccess/CustomerEducation/_git/kentico-docs-autocomplete-vscode"
  },
  "version": "1.2.0",
  "publisher": "kentico-tws",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/src/_configs/_config_primary.yml"
  ],
  "main": "./dist/extension.js",
  "icon": "./resources/neverhood.png",
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.kfm.injection",
        "path": "./grammars/injections/kfmarkdown.json",
        "injectTo": [
          "text.html.markdown"
        ]
      },
      {
        "scopeName": "source.graphql",
        "path": "./grammars/graphql.json"
      }
    ],
    "configuration": {
      "title": "Kentico-flavored MD settings",
      "properties": {
        "kfm.codeBlockHighlight.backgroundColor": {
          "type": "string",
          "default": "rgba(255, 215, 0, 0.1)",
          "description": "Background color for highlighted lines within {% code %} blocks. Use RGBA format for transparency (e.g., rgba(255, 0, 0, 0.2)).",
          "scope": "resource"
        },
        "kfm.codeBlockHighlight.lineNumberHints": {
          "type": "boolean",
          "default": true,
          "description": "Show the relative line number for the current line when inside a {% code %} block.",
          "scope": "resource"
        },
        "kfm.admonitions.highlightEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable background highlight for admonition blocks. (EXPERIMENTAL)",
          "scope": "resource" 
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  }
}
